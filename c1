#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main() {
    // Array to store frequencies for digits 0 to 9, initialized to zero
    int frequency[10] = {0};
    char s[1001];

    // Read the input string from STDIN
    if (scanf("%1000s", s) == 1) {
        // Iterate through each character of the string
        for (int i = 0; s[i] != '\0'; i++) {
            // Check if the character is a digit
            if (s[i] >= '0' && s[i] <= '9') {
                // Increment the frequency map using ASCII offset
                frequency[s[i] - '0']++;
            }
        }
    }

    // Print ten space-separated integers
    for (int i = 0; i < 10; i++) {
        printf("%d ", frequency[i]);
    }
    printf("\n");

    return 0;
}
