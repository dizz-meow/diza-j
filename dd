class Solution(object):
    def scoreOfParentheses(self, s):
        """
        :type s: str
        :rtype: int
        """
        score = 0
        depth = 0
        
        for i in range(len(s)):
            if s[i] == '(':
                depth += 1
            else:
                depth -= 1
                # Check if this forms the innermost pair "()"
                if s[i - 1] == '(':
                    score += 1 << depth  # 1 << depth is equivalent to 2^depth
                    
        return score
